# Laravel backend (server-side only — the browser never calls it directly)
API_URL=http://localhost:8000

# Public address of this site (link previews, sitemap). Local: http://localhost:8713
NEXT_PUBLIC_SITE_URL=https://jvconline.ph

# Same value as INTERNAL_API_KEY in the Laravel .env (lets Laravel see the visitor's IP)
API_INTERNAL_KEY=
